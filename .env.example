# Public frontend configuration. This value is safe to include in a build.
VITE_INTELLIGENCE_API_URL=

# Server-only Vercel environment variables. Never prefix these with VITE_.
FANTASYPROS_API_KEY=
WAR_ROOM_PASSWORD=
WAR_ROOM_SESSION_SECRET=
WAR_ROOM_ALLOWED_ORIGINS=https://lordboby-crypto.github.io,http://localhost:5173,http://127.0.0.1:5173

# Optional server-only overrides for the dedicated encrypted sync project.
# The checked-in defaults use a Supabase publishable key, which is safe to
# distribute; RLS and the recovery-derived vault secret enforce data access.
SYNC_SUPABASE_URL=
SYNC_SUPABASE_PUBLISHABLE_KEY=
